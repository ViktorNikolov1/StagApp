# StagApp Environment Variables
# DO NOT use these values in production.
# Copy this file to .env and replace with real values.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stagapp

# Redis
REDIS_URL=redis://localhost:6379

# JWT Signing Keys (generate RS256 or Ed25519 key pair)
JWT_PRIVATE_KEY=replace-with-private-key
JWT_PUBLIC_KEY=replace-with-public-key

# S3-Compatible Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stagapp-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Email
EMAIL_FROM=noreply@stagapp.local

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
